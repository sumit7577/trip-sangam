# Copy to .env for local dev. Do NOT commit .env.
DJANGO_SECRET_KEY=change-me-to-a-50-char-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WAGTAILADMIN_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Comma-separated full origins (with scheme); required in production for
# Wagtail admin POSTs through an HTTPS proxy.
CSRF_TRUSTED_ORIGINS=

# Where Wagtail "Preview" redirects to (Next.js preview route)
NEXTJS_PREVIEW_URL=http://localhost:3000/preview/

# Bunny CDN Storage — required to upload images to Bunny.
# Leave BUNNY_STORAGE_ACCESS_KEY blank to fall back to local disk (MEDIA_ROOT)
# during dev. Get these values from Bunny dashboard → Storage → your zone.
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_PUBLIC_HOST=
BUNNY_STORAGE_API_HOST=storage.bunnycdn.com
BUNNY_STORAGE_DIRECTORY=sangam/

# ---------------------------------------------------------------------------
# Email (booking notifications + password-reset links) — Gmail SMTP.
# In dev (DJANGO_DEBUG=true) emails print to the console; the vars below only
# take effect in production (DEBUG=false) or if you set EMAIL_BACKEND to SMTP.
#
# Gmail setup (one-time):
#   1. Enable 2-Step Verification on the Google account.
#   2. Visit https://myaccount.google.com/apppasswords and create an
#      App Password (16 chars). Use THAT as EMAIL_HOST_PASSWORD — not your
#      normal Google password.
# Host/port/TLS default to smtp.gmail.com / 587 / TLS in settings.py.
# ---------------------------------------------------------------------------
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
# "From" shown to recipients (Gmail rewrites the envelope to EMAIL_HOST_USER):
DEFAULT_FROM_EMAIL=Trip Sangam <your-account@gmail.com>
# Public site URL — the host used to build reset links in emails:
SITE_PUBLIC_URL=http://localhost:3000
# To force real SMTP in dev too, uncomment:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
